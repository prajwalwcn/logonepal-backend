<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L,NC]
    RewriteRule ^storage/app(/.*)?$ - [F,L,NC]
    RewriteRule ^storage/framework(/.*)?$ - [F,L,NC]
    RewriteRule ^storage/logs(/.*)?$ - [F,L,NC]

    # Rewrite all traffic to public/ folder
    RewriteCond %{REQUEST_URI} !^/logonepal/public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory indexing
Options -Indexes
